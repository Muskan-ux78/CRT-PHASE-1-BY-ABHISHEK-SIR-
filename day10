#include <iostream>
using namespace std;

// Problem -- 3
// Search an element in a 2D matrix
int main() {
    int arr[2][2] = { {1, 2}, {3, 4} };
    int searchElement;

    cout << "Enter element to search: ";
    cin >> searchElement;

    bool found = false; // To track if we actually find it

    for (int i = 0; i < 2; i++) {
        for (int j = 0; j < 2; j++) {
            if (arr[i][j] == searchElement) {
                cout << "Element found at index: " << i << " " << j << endl;
                found = true;
            }
        }
    }

    if (!found) {
        cout << "Element not found in the matrix." << endl;
    }

    return 0;
}
